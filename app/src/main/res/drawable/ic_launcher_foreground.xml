<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Center everything at 54,54 -->
    <group android:translateX="54" android:translateY="54">

        <!-- Soft shadow circle -->
        <path
            android:pathData="M 0,2 m -24,0 a 24,24 0 1,0 48,0 a 24,24 0 1,0 -48,0"
            android:fillColor="#37474F"
            android:fillAlpha="0.2" />

        <!-- Main white circle background -->
        <path
            android:pathData="M 0,0 m -22,0 a 22,22 0 1,0 44,0 a 22,22 0 1,0 -44,0"
            android:fillColor="#FFFFFF" />

        <!-- Combined music note with download arrow -->
        <!-- Music note head (oval) -->
        <path
            android:pathData="M -6,8 C -6,11 -3,13 1,13 C 5,13 8,11 8,8 C 8,5 5,3 1,3 C -3,3 -6,5 -6,8 Z"
            android:fillColor="#546E7A" />

        <!-- Music note stem -->
        <path
            android:pathData="M 6,-14 L 8,-14 L 8,8 L 6,8 Z"
            android:fillColor="#546E7A" />

        <!-- Music note flag (curved) -->
        <path
            android:pathData="M 8,-14 Q 16,-12 16,-6 Q 16,-2 8,-1 L 8,-4 Q 13,-5 13,-7 Q 13,-10 8,-11 Z"
            android:fillColor="#546E7A" />

        <!-- Download arrow overlay on note -->
        <path
            android:pathData="M -10,-4 L -6,-4 L -6,-12 L -2,-12 L -2,-4 L 2,-4 L -4,4 Z"
            android:fillColor="#78909C" />

    </group>
</vector>
